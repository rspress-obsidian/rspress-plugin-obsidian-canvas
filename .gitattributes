# Auto-detect text files and normalize to LF
* text=auto

# --- Source code (normalized as text) ---
*.ts text
*.tsx text
*.js text
*.jsx text
*.css text
*.md text
*.mdx text
*.html text
*.json text
*.yml text
*.yaml text
*.toml text
*.sh text eol=lf

# --- Config & dotfiles ---
.env text
.env.* text
.gitignore text
.gitattributes text
.editorconfig text
.npmrc text
.nvmrc text

# --- Canvas files (JSON-based, should diff properly) ---
*.canvas text

# --- Binary ---
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
bun.lock binary
*.lock binary
