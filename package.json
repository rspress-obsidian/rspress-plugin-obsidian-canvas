{
  "name": "rspress-plugin-obsidian-canvas",
  "version": "0.1.0",
  "type": "module",
  "description": "Rspress plugin to render Obsidian vault canvas files",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/canvas.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rspress",
    "rspress-plugin",
    "obsidian",
    "canvas",
    "obsidian-canvas",
    "json-canvas"
  ],
  "scripts": {
    "build": "tsup && bun scripts/build-css.ts",
    "dev": "tsup --watch",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "check": "biome check --write",
    "test": "bun test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "peerDependencies": {
    "@rspress/core": "^2.0.12",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "happy-dom": "^20.9.0",
    "isomorphic-dompurify": "^3.14.0",
    "lightningcss": "^1.32.0",
    "serve": "^14.2.6",
    "tsup": "^8.5.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/rspress-plugin-obsidian-canvas"
  },
  "bugs": {
    "url": "https://github.com/your-username/rspress-plugin-obsidian-canvas/issues"
  },
  "homepage": "https://github.com/your-username/rspress-plugin-obsidian-canvas#readme"
}
