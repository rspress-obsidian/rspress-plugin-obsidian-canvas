{
  "name": "rspress-plugin-obsidian-canvas",
  "version": "0.1.0",
  "type": "module",
  "description": "Rspress plugin to render Obsidian vault canvas files",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/canvas.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rspress",
    "rspress-plugin",
    "obsidian",
    "canvas",
    "obsidian-canvas",
    "json-canvas"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@rspress/core": "^2.0.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "tsup": "^8.5.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/rspress-plugin-obsidian-canvas"
  },
  "bugs": {
    "url": "https://github.com/your-username/rspress-plugin-obsidian-canvas/issues"
  },
  "homepage": "https://github.com/your-username/rspress-plugin-obsidian-canvas#readme"
}
